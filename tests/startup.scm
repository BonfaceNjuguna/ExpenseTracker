;; Run from the repository root. Android/OpenGL and SQLite calls are mocked;
;; these checks validate Scheme initialization and transaction actions.
(define (string-prefix? prefix text) (and (>= (string-length text) (string-length prefix)) (string=? prefix (substring text 0 (string-length prefix)))))
(define (check value message) (if (not value) (error message)))
(define hooks #f)
(define properties (make-table))
(define last-sql #f)
(define closed #f)
(define fail-query #f)
(define (main . args) (set! hooks args))
(if (not (file-exists? "/tmp/expense-tracker-tests")) (create-directory "/tmp/expense-tracker-tests"))
(define log:path "/tmp/expense-tracker-tests/log")
(define (log-reset!) #t)
(define (log-system . args) #t)
(define (system-directory) "/tmp/expense-tracker-tests")
(define (make-window . args) #t)
(define GUI_PORTRAIT 1)
(define DarkGreen 1)
(define EVENT_KEYPRESS 2)
(define EVENT_KEYESCAPE 3)
(define (glgui-orientation-set! . args) #t)
(define (make-glgui) 'gui)
(define (glgui-width-get) 480)
(define (glgui-height-get) 800)
(define (glgui-box . args) #t)
(define (glgui-uiform . args) 'form)
(define (glgui-widget-set! g f key val) (table-set! properties key val))
(define (uiget key . default) (table-ref properties key (if (null? default) #f (car default))))
(define (glgui-event . args) #t)
(define (glgui-suspend) #t)
(define (glgui-resume) #t)
(define (sqlite-open path) (check (string=? path "/tmp/expense-tracker-tests/expense.sqlite") "database path") 'db)
(define (sqlite-close db) (set! closed #t))
(define (sqlite-query db sql)
  (set! last-sql sql)
  (cond (fail-query #f)
        ((string-prefix? "SELECT COALESCE" sql) '((0)))
        (else '())))
(define ascii_14.fnt 14)
(define ascii_18.fnt 18)
(define ascii_24.fnt 24)
(define ascii_40.fnt 40)
(load "ExpenseTracker/main.scm")
((car hooks) 1080 2400)
(check (equal? (uiget 'type) "Income") "income default")
(check (table? (uiget 'database)) "uiform database exists")
(check (= (expense-total "Income") 0) "empty balance")
(check (string=? (expense-sql-string "O'Brien's lunch") "O''Brien''s lunch") "apostrophe escaping")
(define (widget page kind)
  (let loop ((nodes (cdddr (table-ref expense-tracker-form page))))
    (if (null? nodes) (error "missing widget" kind)
      (if (eq? (caar nodes) kind) (car nodes) (loop (cdr nodes))))))
(define (arg node key)
  (let loop ((args (cdr node)))
    (if (null? args) #f
      (if (eq? (car args) key) (cadr args) (loop (cddr args))))))
(define save (arg (widget 'addtransaction 'button) 'action))
(table-set! properties 'amount "125")
(table-set! properties 'description "O'Brien's lunch")
(check (eq? (save) 'main) "save returns main")
(check (string=? last-sql "INSERT INTO transactions (type, amount, description) VALUES ('Income',125,'O''Brien''s lunch')") "save SQL")
(for-each
  (lambda (amount)
    (table-set! properties 'amount amount)
    (check (list? (save)) "invalid amount displays modal"))
  '("" "abc" "0" "-1" "1+2i"))
(set! fail-query #t)
(check (with-exception-catcher (lambda (e) #t) (lambda () (expense-query "bad") #f)) "SQL failure raises")
((caddr hooks))
(check (and closed (not db)) "database closed")
(display "PASS: initialization, empty balance, quoted descriptions, save, invalid input, SQL errors, shutdown\n")
