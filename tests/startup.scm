;; Real SQLite integration tests; only GUI rendering is replaced by test widgets.
(define (check value message) (if (not value) (error message)))
(define hooks #f)
(define closed #f)
(define test-dir (getenv "EXPENSE_TEST_DIRECTORY" "/tmp/expense-workshop-tests"))
(if (not (file-exists? test-dir)) (create-directory test-dir))
(define log:path (string-append test-dir "/log"))
(define (log-reset!) #t)
(define (log-system . args) #t)
(define (log-error . args) #t)
(define (exception->string e) "Database error")
(define (system-directory) test-dir)
(define (main . args) (set! hooks args))
(define (make-window . args) #t)
(define GUI_PORTRAIT 1)
(define GUI_ALIGNRIGHT 2)
(define EVENT_KEYPRESS 2)
(define EVENT_KEYESCAPE 3)
(define EVENT_KEYUP 4)
(define EVENT_KEYDOWN 5)
(define (color-rgb . args) args)
(define (color-shade color factor) color)
(define (glgui-orientation-set! . args) #t)
(define (make-glgui) (make-table))
(define (glgui-width-get) 480)
(define (glgui-height-get) 800)
(define (test-widget g . args) (make-table))
(define glgui-box test-widget)
(define glgui-label test-widget)
(define glgui-button-string test-widget)
(define (glgui-list g x y w h dh rows callback)
  (let ((widget (make-table)))
    (for-each (lambda (pair) (table-set! widget (car pair) (cadr pair)))
      (list (list 'h h) (list 'dh dh) (list 'list rows) (list 'callback callback) (list 'offset 0.) (list 'current -1)))
    widget))
(define (glgui-uiform g . args)
  (let ((w (make-table))) (set! test-form w) w))
(define test-form #f)
(define (glgui-widget-get g w key) (table-ref w key #f))
(define (glgui-widget-set! g w key val) (table-set! w key val))
(define (uiget key . default) (table-ref test-form key (if (null? default) #f (car default))))
(define (glgui-event . args) #t)
(define (glgui-suspend) #t)
(define (glgui-resume) #t)
(define (terminate) #t)
(define body_12.fnt 12)
(define body_14.fnt 14)
(define body_16.fnt 16)
(define heading_12.fnt 12)
(define heading_14.fnt 14)
(define heading_16.fnt 16)
(define heading_18.fnt 18)
(define heading_22.fnt 22)
(define heading_28.fnt 28)
(define heading_36.fnt 36)
(load (getenv "EXPENSE_TEST_SQLITE"))
(define db-path (string-append test-dir "/expense.sqlite"))
(if (file-exists? db-path) (delete-file db-path))
(define legacy (sqlite-open db-path))
(sqlite-query legacy "CREATE TABLE transactions (type TEXT, amount INTEGER, description TEXT)")
(sqlite-query legacy "INSERT INTO transactions VALUES ('Income',125.50,'Earlier savings')")
(sqlite-close legacy)
(load "ExpenseTracker/main.scm")
((car hooks) 1080 2400)
(check (eq? expense-view 'overview) "starts on dashboard")
(check (= (expense-total "Income") 12550) "legacy decimal amount migrates to cents")
(check (= (expense-total "Expense") 0) "empty expense total")
(check (string=? (list-ref (car (expense-rows "All")) 4) "General") "legacy category retained")
(expense-initialize-db!)
(check (= (expense-total "Income") 12550) "migration is idempotent")
(check (string=? (expense-money 123456789) "KES 1,234,567.89") "currency grouping")
(check (string=? (expense-money -1) "-KES 0.01") "negative balance")
(for-each (lambda (text expected) (check (equal? (expense-parse-cents text) expected) text))
  '("0.10" "12" "12.5" " 12.50 " "0.01" "999999999.99")
  '(10 1200 1250 1250 1 99999999999))
(for-each (lambda (text) (check (not (expense-parse-cents text)) text))
  '("" "abc" "-1" "+1" "1/2" "1e2" "+inf.0" "+nan.0" "1+2i" "1.001" "1." ".5" "1,000" "1000000000"))
(check (eq? (expense-record! "Expense" "0.10" "Food & drink" "O'Brien's lunch") #t) "save quoted description")
(check (eq? (expense-record! "Expense" "0.20" "Food & drink" "Tea") #t) "save another decimal")
(check (= (expense-total "Expense") 30) "decimal totals are exact")
(check (= (length (expense-rows "Expense")) 2) "expense filter")
(check (= (length (expense-rows "Income")) 1) "income filter")
(check (string=? (list-ref (cadr (expense-rows "Expense")) 3) "O'Brien's lunch") "apostrophe roundtrip")
(check (> (string-length (list-ref (car (expense-rows "Expense")) 5)) 10) "new rows have timestamps")
(for-each (lambda (amount) (check (string? (expense-record! "Expense" amount "General" "")) "invalid amount rejected"))
  '("" "0" "-1" "1e2" "1.001"))
(check (string? (expense-record! "Invalid" "10" "General" "")) "invalid type")
(check (string? (expense-record! "Income" "10" "Invalid" "")) "invalid category")
(check (string? (expense-record! "Income" "10" "General" (make-string 201 #\x))) "description limit")
(check (eq? (expense-record! "Income" "99999999.99" "Salary" "Large amount") #t) "large amount")
(check (= (expense-total "Income") 10000012549) "totals exceed 32-bit wrapper range safely")
(expense-show-view! 'activity)
(expense-open-entry! "Expense")
(check (eq? expense-view 'entry) "entry navigation")
(check (member "Other" (expense-category-options "Income")) "income has Other")
(check (member "Other" (expense-category-options "Expense")) "expense has Other")
(check (not (member "Salary" (expense-category-options "Expense"))) "income categories are separate")
(check (not (member "Transport" (expense-category-options "Income"))) "expense categories are separate")
(table-set! test-form 'category "Salary")
(check (string=? (expense-current-category) "Other") "switching type resets incompatible category")
(expense-open-categories!)
(check (eq? expense-view 'categories) "category picker opens")
(check (<= (length (glgui-widget-get expense-list-gui expense-list 'list)) 8) "category list follows selected type")
(glgui-widget-set! expense-list-gui expense-list 'list (make-list 25 #f))
(expense-scroll-list! 1)
(check (= (glgui-widget-get expense-list-gui expense-list 'offset) 1.) "wheel scroll moves list")
(expense-scroll-list! -100)
(check (= (glgui-widget-get expense-list-gui expense-list 'offset) 0.) "scroll clamps at top")
(table-set! test-form 'nodemap '(old-layout))
(expense-select-category! "Transport")
(check (null? (uiget 'nodemap)) "category change rebuilds conditional field hit areas")
(check (string=? (uiget 'category) "Transport") "picker sets compatible category")
(check (equal? (uiget 'type) "Expense") "expense shortcut selects type")
(table-set! test-form 'amount "15.75")
(table-set! test-form 'category "Transport")
(table-set! test-form 'description "Bus")
(expense-save-form!)
(check (eq? expense-view 'activity) "save returns to original view")
(check (= (expense-total "Expense") 1605) "form save uses cents")
(expense-open-entry! "Income")
(check (string=? (uiget 'amount) "") "new form clears prior amount")
(check (string=? (uiget 'description) "") "new form clears prior description")
(check (eq? (expense-record! "Expense" "2.50" "Other" "Custom test" "  Pets' care  ") #t) "save custom category")
(check (string=? (list-ref (car (expense-rows "Expense")) 4) "Pets' care") "custom category escaped and trimmed")
(check (eq? (expense-record! "Income" "1.00" "Other" "Unnamed" " ") #t) "unnamed Other stays valid")
(check (string=? (list-ref (car (expense-rows "Income")) 4) "Other") "blank custom name stays Other")
(check (string? (expense-record! "Income" "1.00" "Other" "" (make-string 41 #\x))) "custom category length limit")
(table-set! test-form 'custom-category "Old income label")
(table-set! test-form 'type "Expense")
(check (string=? (expense-current-category) "Other") "type switch retains Other")
(check (string=? (uiget 'custom-category) "") "type switch clears custom name")
(table-set! test-form 'type "Income")
(table-set! test-form 'category-type "Income")
(table-set! test-form 'custom-category "Old income label")
(table-set! test-form 'amount "1.00")
(table-set! test-form 'type "Expense")
(expense-save-form!)
(check (string=? (list-ref (car (expense-rows "Expense")) 4) "Other") "saving immediately after type change does not reuse old custom name")
((caddr hooks))
(check (not db) "database closed")
(set! db (sqlite-open db-path))
(expense-initialize-db!)
(check (= (expense-total "Expense") 1955) "records persist across reopen")
;; CRUD uses stable IDs and updates the original row rather than appending.
(define custom-row (cadr (expense-rows "Expense")))
(define edit-id (string->number (car custom-row)))
(define original-count (length (expense-rows "All")))
(define original-date (list-ref custom-row 5))
(define original-income (expense-total "Income"))
(define original-expense (expense-total "Expense"))
(expense-show-view! 'overview)
(glgui-widget-set! gui expense-list 'current 1)
((glgui-widget-get gui expense-list 'callback) gui expense-list)
(check (eq? expense-view 'entry) "click opens a transaction")
(check (= expense-edit-id (string->number (car (cadr (expense-rows "All"))))) "click targets selected row")
(expense-show-view! 'activity)
(expense-open-transaction! edit-id)
(check (string=? (uiget 'amount) "2.50") "edit prefills exact amount")
(check (string=? (uiget 'category) "Other") "custom category uses Other editor")
(check (string=? (uiget 'custom-category) "Pets' care") "custom category survives opening editor")
(table-set! test-form 'type "Income")
(expense-current-category)
(table-set! test-form 'custom-category "Workshop's stipend")
(table-set! test-form 'amount "30.25")
(table-set! test-form 'description "Edited 'entry'")
(expense-save-form!)
(check (eq? expense-view 'activity) "edit returns to Activity")
(check (not expense-edit-id) "navigation clears editing state")
(check (= (length (expense-rows "All")) original-count) "edit does not insert a duplicate")
(check (= (expense-total "Income") (+ original-income 3025)) "changing type adds to income")
(check (= (expense-total "Expense") (- original-expense 250)) "changing type removes previous expense")
(check (string=? (list-ref (expense-find-row edit-id) 5) original-date) "edit preserves creation date")
(check (string=? (list-ref (expense-find-row edit-id) 4) "Workshop's stipend") "edited custom category escapes quotes")
(check (string=? (list-ref (expense-find-row edit-id) 3) "Edited 'entry'") "edited description escapes quotes")
(check (string? (expense-update! edit-id "Income" "0" "Salary" "Invalid")) "invalid edit rejected")
(check (string=? (caddr (expense-find-row edit-id)) "3025") "invalid edit leaves saved values unchanged")
(expense-open-transaction! edit-id)
(table-set! test-form 'amount "999")
(expense-show-view! 'activity)
(check (string=? (caddr (expense-find-row edit-id)) "3025") "cancel discards unsaved edits")
;; Opening/canceling confirmation must not delete; only its action does.
(expense-open-transaction! edit-id)
(table-set! test-form 'page 'delete)
((cadr hooks) EVENT_KEYPRESS EVENT_KEYESCAPE 0)
(check (eq? (uiget 'page) 'main) "Back dismisses delete confirmation")
(check (expense-find-row edit-id) "cancel confirmation keeps record")
(expense-delete-form!)
(check (eq? expense-view 'activity) "delete returns to source view")
(check (not (expense-find-row edit-id)) "delete removes selected row")
(check (= (length (expense-rows "All")) (- original-count 1)) "delete removes exactly one row")
(check (= (expense-total "Income") original-income) "delete refreshes total")
(check (string? (expense-update! edit-id "Expense" "1" "Other" "Gone")) "missing update rejected")
(check (string? (expense-delete! edit-id)) "missing delete rejected")
(check (string? (expense-delete! "1 OR 1=1")) "invalid ID cannot delete rows")
;; Legacy categories and blank dates remain editable without inventing dates.
(expense-show-view! 'overview)
(expense-open-transaction! 1)
(check (string=? (uiget 'custom-category) "General") "legacy category prefilled")
(expense-save-form!)
(check (string=? (list-ref (expense-find-row 1) 5) "") "legacy edit retains blank date")
(expense-open-entry! "Expense")
(check (not expense-edit-id) "new transaction cannot overwrite prior edit")
;; Overview queries and renders only the newest ten; Activity keeps all rows.
(let loop ((i 0))
  (if (< i 13)
      (begin (expense-record! "Expense" "1.00" "Other" (number->string i)) (loop (+ i 1)))))
(check (= (length (expense-rows "All" 10)) 10) "recent SQL limit")
(check (string=? (list-ref (car (expense-rows "All" 10)) 3) "12") "recent rows are newest first")
(expense-show-view! 'overview)
(check (= (length (glgui-widget-get gui expense-list 'list)) 10) "Overview renders ten transactions")
(set! expense-filter "All")
(expense-show-view! 'activity)
(check (= (length (glgui-widget-get gui expense-list 'list)) (length (expense-rows "All"))) "Activity renders entire history")
(set! expense-filter "Income")
(expense-show-view! 'activity)
(check (= (length (glgui-widget-get gui expense-list 'list)) (length (expense-rows "Income"))) "Activity filter retained")
(define persisted-count (length (expense-rows "All")))
(sqlite-close db)
(set! db (sqlite-open db-path))
(check (= (length (expense-rows "All")) persisted-count) "CRUD persists after reopen")
(check (not (expense-find-row edit-id)) "deleted transaction stays deleted")
(sqlite-close db)
(set! db #f)
(display "PASS: migration, exact cents, categories, CRUD, confirmation, recent-ten limit, filters, and persistence\n")
