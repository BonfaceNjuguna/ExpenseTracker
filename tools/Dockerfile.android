FROM fedora:43
RUN dnf -y install \
    alsa-lib-devel ant autoconf automake bc curl gambit-c gcc-14 git grep \
    ImageMagick java-25-openjdk-devel libtool libXext-devel make \
    mesa-libGL-devel mesa-libGLU-devel netpbm-devel patch perl-FindBin \
    portaudio python3-sdkmanager sed tar tcl-devel which wget zip unzip \
    m4 pkgconf-pkg-config gettext-devel autoconf-archive \
    && dnf clean all
# LambdaNative validates source archives with the Perl shasum command.
RUN dnf -y install perl-Digest-SHA && dnf clean all
